# Batch/bulk operation limits (H-05, H-06, M-04)
# Maximum files per batch operation (mergeNotes, etc.)
# OBSIDIAN_BATCH_LIMIT=50
# Maximum files for regex replace operations
# OBSIDIAN_REPLACE_LIMIT=100

# Maximum search/list results returned (default: 500)
# OBSIDIAN_SEARCH_LIMIT=500

# Query timeout in milliseconds (default: 10000)
# Applies to executeDataviewQuery and other long-running operations (M-07)
# OBSIDIAN_QUERY_TIMEOUT_MS=10000

# Set to true to permanently delete files instead of moving to .trash/
# OBSIDIAN_HARD_DELETE=false
